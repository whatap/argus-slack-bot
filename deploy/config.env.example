# /etc/argus-slack-bot/config.env — 비밀이 아닌 운영 설정 (root:whatap 0640)
# 형식: KEY=value (따옴표 없이). remote-install.sh 도 SLACK_HTTP_PORT·WHATAP_OAUTH_PORT 를 여기서 읽는다.
# 비밀값 5개(SLACK_SIGNING_SECRET, SLACK_CLIENT_SECRET, SLACK_STATE_SECRET, SLACK_TOKENS_ENCRYPTION_KEY,
# WHATAP_OAUTH_CLIENT_SECRET)는 넣지 않는다. 시작할 때 load-secrets.sh 가 Secrets Manager 에서 읽는다.
# <...> 는 확정 후 채운다.

# Slack — HTTP 수신, 공개 다중 워크스페이스
SLACK_TRANSPORT=http
SLACK_HTTP_PORT=3000
# ALB 가 인스턴스로 바로 보내므로 모든 주소에서 받고, 3000·3901 은 보안그룹으로 ALB 만 허용한다
SLACK_LISTEN_HOST=0.0.0.0
SLACK_PUBLIC_URL=https://argus-bot.whatap.io
SLACK_APP_ID=A0AFUKNJ5SS
SLACK_CLIENT_ID=<Slack 앱 Basic Information 의 Client ID>

# SQLite — 영속 디스크. 백업은 backup.sh
SLACK_INSTALLATIONS_DB=/data/whatap/argus-slack-bot/data/installations.sqlite
SLACK_USER_TOKENS_DB=/data/whatap/argus-slack-bot/data/user_tokens.sqlite
SLACK_THREAD_HISTORY_DB=/data/whatap/argus-slack-bot/data/thread_history.sqlite

# 와탭 로그인(OAuth) — 운영 front 의 로그인 서버에 등록한 봇 클라이언트 (운영 로그인 서버 활성화 후 확정)
WHATAP_OAUTH_ISSUER=<운영 로그인 서버 issuer, 예: https://service.whatap.io>
WHATAP_OAUTH_CLIENT_ID=<로그인 서버에 등록한 봇 client id>
WHATAP_OAUTH_REDIRECT_URI=https://argus-bot.whatap.io/oauth/callback
WHATAP_OAUTH_PORT=3901
WHATAP_OAUTH_LISTEN_HOST=0.0.0.0

# Argus — front 가 Argus 를 부를 때 쓰는 주소(argus_backend_url)와 같은 곳
ARGUS_URL=<Argus 주소>

# AWS — 인스턴스 역할로 읽는다
AWS_REGION=ap-northeast-2
ASB_SECRETS_ID=<Secrets Manager 비밀 이름 또는 ARN>
BACKUP_S3_URI=<s3://버킷/경로/backups>
